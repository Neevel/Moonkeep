rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function profile(uid) {
      return /databases/$(database)/documents/memberships/$(uid);
    }
    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }
    function memberPath(fid, uid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(uid);
    }
    function invitePath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }
    function eventPath(fid, eid) {
      return /databases/$(database)/documents/families/$(fid)/events/$(eid);
    }
    function member(fid) {
      return verified() && get(profile(request.auth.uid)).data.familyId == fid;
    }
    function activeFamilyData(data) {
      return data.get('status', 'active') == 'active';
    }
    function activeFamily(fid) {
      return activeFamilyData(get(familyPath(fid)).data);
    }
    function activeMember(fid) {
      return member(fid) && activeFamily(fid);
    }
    function owner(fid) {
      return activeMember(fid)
        && get(familyPath(fid)).data.ownerId == request.auth.uid;
    }
    function validInvitation(code, fid) {
      let before = get(invitePath(code)).data;
      let after = getAfter(invitePath(code)).data;
      return activeFamily(fid)
        && before.familyId == fid && before.acceptedBy == null
        && before.expiresAt > request.time
        && after.acceptedBy == request.auth.uid && after.acceptedAt == request.time;
    }
    match /memberships/{uid} {
      allow get: if verified()
        && (uid == request.auth.uid || owner(resource.data.familyId));
      allow create: if verified() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['familyId', 'invitationId', 'joinedAt'])
        && request.resource.data.familyId is string
        && request.resource.data.joinedAt == request.time
        && ((request.resource.data.invitationId == null
          && !exists(familyPath(request.resource.data.familyId))
          && getAfter(familyPath(request.resource.data.familyId)).data.ownerId == uid)
          || (request.resource.data.invitationId is string
            && validInvitation(request.resource.data.invitationId, request.resource.data.familyId)));
      allow delete: if verified() && uid == request.auth.uid
        && resource.data.familyId is string
        && ((get(familyPath(resource.data.familyId)).data.ownerId != uid
            && !existsAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(uid)))
          || (get(familyPath(resource.data.familyId)).data.ownerId == uid
            && activeFamily(resource.data.familyId)
            && getAfter(familyPath(resource.data.familyId)).data.status == 'dissolved'
            && getAfter(familyPath(resource.data.familyId)).data
              .diff(get(familyPath(resource.data.familyId)).data)
              .affectedKeys().hasOnly(['status'])));
      allow list, update: if false;
    }
    match /families/{fid} {
      function validOwnershipTransfer() {
        let oldOwner = resource.data.ownerId;
        let newOwner = request.resource.data.ownerId;
        return verified() && activeFamilyData(resource.data)
          && oldOwner == request.auth.uid
          && newOwner is string && newOwner != oldOwner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId'])
          && exists(profile(newOwner))
          && get(profile(newOwner)).data.familyId == fid
          && exists(memberPath(fid, newOwner))
          && get(memberPath(fid, oldOwner)).data.role == 'owner'
          && get(memberPath(fid, newOwner)).data.role == 'member'
          && getAfter(memberPath(fid, oldOwner)).data.role == 'member'
          && getAfter(memberPath(fid, newOwner)).data.role == 'owner';
      }
      function validDissolution() {
        return verified() && activeFamilyData(resource.data)
          && resource.data.ownerId == request.auth.uid
          && get(profile(request.auth.uid)).data.familyId == fid
          && request.resource.data.status == 'dissolved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && !existsAfter(profile(request.auth.uid));
      }
      function validDisplayName(value) {
        return value is string
          && value.size() >= 1 && value.size() <= 40
          && value.matches('^\\S(.*\\S)?$');
      }
      allow get: if member(fid);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'status', 'timeZone', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.ownerId == request.auth.uid
        && activeFamilyData(request.resource.data)
        && request.resource.data.timeZone == 'Europe/Berlin'
        && request.resource.data.createdAt == request.time
        && !exists(profile(request.auth.uid))
        && getAfter(profile(request.auth.uid)).data.familyId == fid
        && getAfter(profile(request.auth.uid)).data.invitationId == null;
      allow update: if validOwnershipTransfer() || validDissolution();
      allow list, delete: if false;

      match /members/{memberId} {
        function validMemberProfile() {
          return request.resource.data.keys().hasOnly(['email', 'role', 'joinedAt', 'displayName'])
            && request.auth.token.email is string
            && request.resource.data.email == request.auth.token.email
            && (!request.resource.data.keys().hasAny(['displayName'])
              || validDisplayName(request.resource.data.displayName))
            && request.resource.data.joinedAt
              == getAfter(profile(request.auth.uid)).data.joinedAt
            && request.resource.data.role
              == (getAfter(familyPath(fid)).data.ownerId == request.auth.uid
                ? 'owner' : 'member');
        }
        function validOwnershipRoleTransfer() {
          let oldOwner = get(familyPath(fid)).data.ownerId;
          let newOwner = getAfter(familyPath(fid)).data.ownerId;
          return verified() && activeFamily(fid)
            && request.auth.uid == oldOwner
            && newOwner is string && newOwner != oldOwner
            && memberId in [oldOwner, newOwner]
            && getAfter(familyPath(fid)).data.diff(get(familyPath(fid)).data)
              .affectedKeys().hasOnly(['ownerId'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && resource.data.role == (memberId == oldOwner ? 'owner' : 'member')
            && request.resource.data.role == (memberId == oldOwner ? 'member' : 'owner')
            && exists(profile(newOwner))
            && get(profile(newOwner)).data.familyId == fid
            && getAfter(memberPath(fid, oldOwner)).data.role == 'member'
            && getAfter(memberPath(fid, newOwner)).data.role == 'owner';
        }
        function validOwnDisplayNameUpdate() {
          return verified() && activeMember(fid)
            && memberId == request.auth.uid
            && request.resource.data.keys().hasAll(['displayName'])
            && validDisplayName(request.resource.data.displayName)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName']);
        }
        allow read: if activeMember(fid);
        allow create: if verified()
          && memberId == request.auth.uid
          && activeFamilyData(getAfter(familyPath(fid)).data)
          && getAfter(profile(request.auth.uid)).data.familyId == fid
          && validMemberProfile();
        allow delete: if verified() && memberId == request.auth.uid
          && get(profile(request.auth.uid)).data.familyId == fid
          && get(familyPath(fid)).data.ownerId != request.auth.uid
          && !existsAfter(profile(request.auth.uid));
        allow update: if validOwnershipRoleTransfer()
          || validOwnDisplayNameUpdate();
      }

      match /events/{eid} {
        function daysInMonth(y, m) {
          return m == 2 ? ((y % 400 == 0 || (y % 4 == 0 && y % 100 != 0)) ? 29 : 28)
            : (m in [4, 6, 9, 11] ? 30 : 31);
        }
        function validEvent(d) {
          return d.keys().hasOnly(['title', 'notes', 'year', 'month', 'day',
            'endYear', 'endMonth', 'endDay', 'startMinute', 'endMinute',
            'importance', 'reminderMinutesBefore',
            'allDay', 'recurrence', 'assignedMemberIds', 'revision',
            'updatedBy', 'updatedAt'])
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
            && d.notes is string && d.notes.size() <= 2000
            && d.year is int && d.year >= 1900 && d.year <= 2100
            && d.month is int && d.month >= 1 && d.month <= 12
            && d.day is int && d.day >= 1 && d.day <= daysInMonth(d.year, d.month)
            && d.startMinute is int && d.startMinute >= 0 && d.startMinute < 1440
            && d.endMinute is int && d.endMinute >= 0 && d.endMinute < 1440
            && validEventEnd(d)
            && (!d.keys().hasAny(['importance'])
              || d.importance in ['low', 'normal', 'high'])
            && (!d.keys().hasAny(['reminderMinutesBefore'])
              || d.reminderMinutesBefore == null
              || d.reminderMinutesBefore in [0, 10, 30, 60, 1440])
            && d.get('allDay', false) is bool
            && (!d.get('allDay', false)
              || d.get('reminderMinutesBefore', null) == null)
            && validRecurrence(d)
            && validAssignments(d)
            && d.revision is int && d.updatedBy == request.auth.uid
            && d.updatedAt == request.time;
        }
        function validEventEnd(d) {
          let hasEndDate = d.keys().hasAny(['endYear', 'endMonth', 'endDay']);
          return (!hasEndDate && d.endMinute > d.startMinute)
            || (hasEndDate
              && d.keys().hasAll(['endYear', 'endMonth', 'endDay'])
              && d.endYear is int && d.endYear >= 1900 && d.endYear <= 2100
              && d.endMonth is int && d.endMonth >= 1 && d.endMonth <= 12
              && d.endDay is int && d.endDay >= 1
              && d.endDay <= daysInMonth(d.endYear, d.endMonth)
              && d.endYear * 10000 + d.endMonth * 100 + d.endDay
                > d.year * 10000 + d.month * 100 + d.day);
        }
        function validAssignments(d) {
          let assignments = d.get('assignedMemberIds', []);
          return assignments is list && assignments.size() <= 50;
        }
        function validRecurrence(d) {
          let r = d.get('recurrence', null);
          return r == null
            || (r is map
              && !d.keys().hasAny(['endYear', 'endMonth', 'endDay'])
              && r.keys().hasOnly([
                'frequency', 'endYear', 'endMonth', 'endDay'])
              && r.frequency in [
                'daily', 'weekly', 'biweekly', 'monthly', 'yearly']
              && ((!r.keys().hasAny(['endYear', 'endMonth', 'endDay']))
                || (r.keys().hasAll(['endYear', 'endMonth', 'endDay'])
                  && r.endYear is int
                  && r.endYear >= 1900 && r.endYear <= 2100
                  && r.endMonth is int
                  && r.endMonth >= 1 && r.endMonth <= 12
                  && r.endDay is int
                  && r.endDay >= 1
                  && r.endDay <= daysInMonth(r.endYear, r.endMonth)
                  && r.endYear * 10000 + r.endMonth * 100 + r.endDay
                    >= d.year * 10000 + d.month * 100 + d.day)));
        }
        allow read: if activeMember(fid);
        allow create: if activeMember(fid) && validEvent(request.resource.data)
          && request.resource.data.revision == 1;
        allow update: if activeMember(fid) && validEvent(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if activeMember(fid);
      }

      match /activity/{activityId} {
        function validActivity() {
          let d = request.resource.data;
          let path = eventPath(fid, d.eventId);
          return d.keys().hasOnly([
              'action', 'eventId', 'title', 'actorId', 'createdAt'])
            && d.action in ['created', 'deleted']
            && d.eventId is string && d.eventId.matches('^[a-f0-9]{32}$')
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
            && d.actorId == request.auth.uid
            && d.createdAt == request.time
            && ((d.action == 'created'
                && !exists(path)
                && getAfter(path).data.title == d.title
                && getAfter(path).data.updatedBy == request.auth.uid)
              || (d.action == 'deleted'
                && exists(path)
                && !existsAfter(path)
                && get(path).data.title == d.title));
        }
        allow read: if activeMember(fid);
        allow create: if activeMember(fid) && validActivity();
        allow update, delete: if false;
      }
    }
    match /invitations/{code} {
      // A random 128-bit code is a bearer invitation, never a short guessable PIN.
      allow get: if verified() && code.matches('^[a-f0-9]{32}$')
        && activeFamily(resource.data.familyId);
      allow list: if owner(resource.data.familyId);
      allow create: if code.matches('^[a-f0-9]{32}$')
        && owner(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly(['familyId', 'createdAt', 'expiresAt', 'acceptedBy', 'acceptedAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && request.resource.data.acceptedBy == null && request.resource.data.acceptedAt == null;
      allow update: if verified() && activeFamily(resource.data.familyId)
        && resource.data.acceptedBy == null
        && resource.data.expiresAt > request.time
        && !exists(profile(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy', 'acceptedAt'])
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && getAfter(profile(request.auth.uid)).data.familyId == resource.data.familyId
        && getAfter(profile(request.auth.uid)).data.invitationId == code;
      allow delete: if owner(resource.data.familyId);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
